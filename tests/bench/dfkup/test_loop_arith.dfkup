fn isPrime(n: int): bool =
  var i = 2
  result = true
  while i * i <= n:
    if n == i * (n / i):
      result = false
      i = n
    i = i + 1

echo "isPrime(5) = "
echo isPrime(5)
echo "isPrime(7) = "
echo isPrime(7)
echo "isPrime(9) = "
echo isPrime(9)

fn countPrimes(n: int): int =
  var i = 2
  var count = 0
  while i < n:
    if isPrime(i):
      count = count + 1
    i = i + 1
  result = count

echo "countPrimes(10) = "
echo countPrimes(10)
