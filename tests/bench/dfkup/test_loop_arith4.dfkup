fn withDiv(n: int): bool =
  var i = 2
  result = true
  while i < n:
    if n / i == 2:
      result = false
    i = i + 1

echo "withDiv(5) = "
echo withDiv(5)
echo "withDiv(4) = "
echo withDiv(4)

fn callWithDiv(n: int): int =
  var i = 2
  var count = 0
  while i < n:
    if withDiv(i):
      count = count + 1
    i = i + 1
  result = count

echo "callWithDiv(10) = "
echo callWithDiv(10)
