fn whileAndIf(n: int): bool =
  var i = 2
  result = true
  while i < n:
    if i == 3:
      result = false
    i = i + 1

echo "whileAndIf(5) = "
echo whileAndIf(5)
echo "whileAndIf(3) = "
echo whileAndIf(3)

fn callIt(n: int): int =
  var i = 2
  var count = 0
  while i < n:
    if whileAndIf(i):
      count = count + 1
    i = i + 1
  result = count

echo "callIt(10) = "
echo callIt(10)
