fn fizzbuzz(n: int): int =
  var fizz = 0
  var buzz = 0
  var both = 0
  var plain = 0
  var i = 1
  while i <= n:
    if i % 3 == 0:
      if i % 5 == 0:
        both = both + 1
      else:
        fizz = fizz + 1
    elif i % 5 == 0:
      buzz = buzz + 1
    else:
      plain = plain + 1
    i = i + 1
  result = fizz + buzz + both + plain

echo fizzbuzz(20000000)
