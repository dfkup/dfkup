fn hasWhile(n: int): bool =
  var i = 2
  result = true
  while i < n:
    i = i + 1

echo "hasWhile(5) = "
echo hasWhile(5)

fn callWithWhile(n: int): int =
  var i = 2
  var count = 0
  while i < n:
    if hasWhile(i):
      count = count + 1
    i = i + 1
  result = count

echo "callWithWhile(10) = "
echo callWithWhile(10)
