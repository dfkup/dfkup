import "std/twofa"

echo genSecret()
let t = newTotp("JBSWY3DPEHPK3PXP", "MyApp", "alice@example.com")
echo totpNow(t)
echo totpAt(t, 1234567890)
echo totpVerify(t, totpAt(t, 1234567890), 1234567890)
echo totpUri(t)
var h = newHotp("JBSWY3DPEHPK3PXP")
echo hotpAt(h, 0)
echo hotpNext(h)
echo hotpUri(h)
