# HTTP server example
# Run: dfkup run examples/lib_http.dfkup --nojit
# Then visit http://localhost:8080/hello in your browser

import "std/http"

#
# 1. Define the request handler
#    Receives (path, method) and returns a response string
#
fn handler(path, method): string =
  if path == "/hello":
    return "Hello from dfkup!"
  elif path == "/test":
    return "This is a test page"
  else:
    return "Path: " & path & " Method: " & method

#
# 2. Create a new web server
#
echo "--- Creating web server ---"
let server = newWebServer()

#
# 3. Start listening on port 8080
#    Pass the handler function by name
#
echo "Server running at http://localhost:8080"
echo "Try: curl http://localhost:8080/hello"
echo "Press Ctrl+C to stop"
listen(server, 8080, handler)