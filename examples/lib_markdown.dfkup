import "std/markdown"
import "std/json"

let md = parseMarkdown("# Hello\n\nworld\n\n## Sub\n")
echo md.getTitle()
echo md.getHeadings()
echo md.hasHeadings()
echo md.getHtml()
echo parseMarkdown("# No anchors\n", parseJson("{\"anchors\": false}")).getHtml()
echo parseMarkdown("---\ntitle: Hi\n---\n\nbody").getMeta()

let fmd = parseMarkdownFile("tests/fixtures/sample.md")
echo fmd.getTitle()
echo fmd.getHeadings()
echo fmd.getMeta()
echo fmd.hasHeadings()
echo fmd.hasFootnotes()
echo fmd.getJson()


# A brace body can hold an indent-based `if` inside it; the two nest
# independently and both stay on 2-space steps.
fn fib(n: int): int {
  if n < 2:
    result = n
  else:
    result = fib(n - 1) + fib(n - 2)
}
echo "fib(30) = "
echo fib(30)