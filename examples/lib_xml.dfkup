import "std/xml"

let d = parseXml("<root lang=\"en\"><item id=\"1\">hello</item></root>")
echo tagName(d)              # "root"
echo getAttr(d, "lang", "?") # "en"
echo childCount(d)           # 1
let item = findChild(d, "item")
echo getText(item)           # "hello"
echo getXml(d)

let f = parseXmlFile("tests/fixtures/sample.xml")
echo tagName(f)          # "root"
